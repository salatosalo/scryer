# 1. Riot Games Developer API Key (https://developer.riotgames.com/)
# Dev key lasts 24h; replace it here when expired and restart the app.
RIOT_API_KEY=RGAPI-your-key-here

# 2. Primary AI Provider: 'gemini' (recommended, Free Tier) or 'groq'
AI_PROVIDER=gemini

# AI Analysis Mode:
# 'compact' (recommended, default) - Analyzes key moments & draft/build (~3k tokens, 85% cheaper)
# 'deep' - Generates full AI reviews for every single minute 1..N (~15k-30k tokens)
AI_ANALYSIS_MODE=compact

# 3. Google Gemini API Key (Free Tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. Optional fallback: Groq API Key (Free Tier at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
